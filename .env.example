# Example configuration for Local Organiser.
# Values are read from the process environment; this file is NOT loaded automatically.
# Diese Datei ist eine Vorlage und enthaelt bewusst KEINE echten Secrets.
# Die echte Konfiguration liegt ausserhalb des Repositorys, standardmaessig in
# /home/your-user/.config/local-organiser/organiser.env mit Modus 0600.
# Der Token unten ist nur ein Platzhalter und muss vor dem Start ersetzt werden:
#   openssl rand -hex 32

# Pflicht: Bearer-Token fuer alle fachlichen API-Routen.
# Ohne diesen Wert antworten die geschuetzten Routen mit 503 (Fail closed).
# /health und die API-Dokumentation bleiben ohne Token erreichbar;
# fachliche Datenrouten sind geschuetzt.
ORGANISER_API_TOKEN=CHANGE_ME_openssl_rand_hex_32

# Optional: abweichender SQLite-Pfad (Standard: <Projektroot>/data/inbox.sqlite3)
# ORGANISER_DATABASE_PATH=/srv/local-organiser/data/inbox.sqlite3

# Optional: lokaler OpenAI-kompatibler Interpreter
# ORGANISER_LLM_BASE_URL=http://127.0.0.1:8080/v1
# ORGANISER_LLM_MODEL=local-general
# ORGANISER_LLM_TIMEOUT_SECONDS=60

# Optional: Knowledge Root fuer das filesystem-basierte Context-Wissen.
# Das Verzeichnis liegt bewusst ausserhalb des Repositorys; die erzeugten
# Markdown-Dateien sind persoenliche Daten und werden nicht eingecheckt.
# ORGANISER_KNOWLEDGE_ROOT=/srv/local-organiser/knowledge

# Optional: CalDAV-Zugriff (echte Werte nur in der externen ENV-Datei)
# ORGANISER_CALDAV_URL=https://caldav.icloud.com
# ORGANISER_CALDAV_USERNAME=
# ORGANISER_CALDAV_APP_PASSWORD=
# ORGANISER_CALDAV_CALENDARS=Privat,Uni
# ORGANISER_CALDAV_ORGANISER_CALENDAR=Organiser
# ORGANISER_CALENDAR_TIMEZONE=Europe/Berlin

# Optional: freigegebene Wurzelverzeichnisse fuer die Dateiaufnahme .
# JSON-Liste absoluter Pfade. Ohne diesen Wert wird gar nichts gelesen
# (Default deny). Die Quelle muss zusaetzlich aktiv sein und unterhalb eines
# dieser Wurzeln liegen; Wissens-, Projekt-, VCS-, Venv- und versteckte
# Verzeichnisse sind ausgeschlossen. Der Wert wird nur von der Konfiguration
# gesetzt und kann nicht pro Anfrage erweitert werden.
# ORGANISER_SOURCE_ALLOWED_ROOTS=["/srv/local-organiser/sources/study"]
